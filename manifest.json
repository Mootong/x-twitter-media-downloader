{
  "manifest_version": 3,
  "name": "X/Twitter Media Downloader",
  "version": "0.2.0",
  "description": "Download images and videos posted by a specified X/Twitter user in a date range.",
  "permissions": ["activeTab", "downloads", "storage", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "http://127.0.0.1:17863/*"
  ],
  "action": {
    "default_title": "X Media Downloader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["review.html", "review.css", "review.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
